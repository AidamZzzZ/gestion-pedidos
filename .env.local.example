NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# Solo servidor: NUNCA debe llevar el prefijo NEXT_PUBLIC_ (eso lo mandaria al navegador).
# Dashboard -> Project Settings -> API -> "service_role" secret key.
# Usada unicamente para crear/borrar cuentas de vendedores desde el panel admin.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Numero de WhatsApp de la empresa (con codigo de pais, solo digitos, sin "+").
# A donde se manda el mensaje pre-escrito al confirmar/cancelar un pedido.
NEXT_PUBLIC_WHATSAPP_EMPRESA=584121234567
